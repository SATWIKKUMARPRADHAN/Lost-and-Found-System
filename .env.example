# Django Secret Key (generate a random 50+ character string for production)
DJANGO_SECRET_KEY=django-insecure-campus-lost-found-secret-key-change-in-production

# Set to True for local development, False for production on Render
DEBUG=True

# Allowed Hosts (comma-separated, e.g. localhost,127.0.0.1,.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL
# Local SQLite is used automatically when DATABASE_URL is not set.
# For production PostgreSQL on Render, set:
# DATABASE_URL=postgres://user:password@host:port/database_name
# DATABASE_URL=

# Cloudinary Configuration for persistent production image storage
# (Sign up free at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
